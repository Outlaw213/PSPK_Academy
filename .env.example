# Copy to .env and fill in. Never commit .env (NFR-03).
ENVIRONMENT=development

POSTGRES_USER=pspk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pspk_academy

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Photos: own disk on the server (ADR-24), resized on upload (ADR-25).
# Host path of the photo disk; leave empty to use a Docker volume.
PHOTO_STORAGE_PATH=
MAX_UPLOAD_SIZE_MB=10
MAX_SUBMISSION_PHOTOS=10
MAX_ATTACHMENT_SIZE_MB=20
IMAGE_MAX_EDGE=2560
IMAGE_QUALITY=82
